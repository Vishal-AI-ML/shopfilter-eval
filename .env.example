APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://shopfilter:shopfilter@localhost:5432/shopfilter
REDIS_URL=redis://localhost:6379/0
WORKER_HEARTBEAT_SECONDS=10
WORKER_STALE_AFTER_SECONDS=60
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=shopfilter
MINIO_SECRET_KEY=shopfilter-dev-only
MINIO_SECURE=false
MINIO_BUCKET=shopfilter-artifacts
SESSION_DURATION_HOURS=12
SESSION_COOKIE_SECURE=false
PUBLIC_WEB_URL=http://localhost:3000
EMAIL_VERIFICATION_EXPIRY_MINUTES=60
EMAIL_VERIFICATION_EMAIL_DIRECTORY=artifacts/mailbox
PASSWORD_RESET_EXPIRY_MINUTES=30
PASSWORD_RESET_EMAIL_DIRECTORY=artifacts/mailbox
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=no-reply@shopfilter.local
SMTP_USE_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SHOPFILTER_API_INTERNAL_URL=http://localhost:8000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
